# ── 토스증권 Open API 자격증명 ──────────────────────────────
# 발급: 토스증권 WTS 로그인 → 설정 > Open API 에서 client_id / client_secret 발급
# 이 파일을 .env 로 복사한 뒤 본인 값으로 채우세요. (.env 는 git에 올라가지 않습니다)
TOSS_CLIENT_ID=여기에_client_id
TOSS_CLIENT_SECRET=여기에_client_secret

# 매매할 계좌의 accountSeq (정수). 비워두면 첫 번째 위탁계좌를 자동 선택합니다.
TOSS_ACCOUNT_SEQ=

# ── Claude API ──────────────────────────────────────────────
ANTHROPIC_API_KEY=여기에_anthropic_api_key

# ── 안전장치 (실거래 시 필수로 검토) ────────────────────────
# DRY_RUN=true 이면 실제 주문을 내지 않고 로그만 남깁니다. 충분히 검증 전까지 true 유지 권장.
DRY_RUN=true

# 코스피 프록시 종목. 토스 API는 코스피 지수값을 제공하지 않으므로 ETF로 대용합니다.
# 069500 = KODEX 200 (코스피200 추종). 원하면 변경 가능.
KOSPI_PROXY_SYMBOL=069500

# ── 종목 선정 방식 ─────────────────────────────────────────
# DYNAMIC_UNIVERSE=true 이면 Claude 가 매일(1일 1회) web_search 로 뉴스/코스피/등락을
# 직접 조사해 매매 후보를 고릅니다. 고른 종목은 토스 /stocks 로 실재·상장·이름 검증을 거치고,
# 투자경고/위험/과열/정리매매 종목은 제외합니다(SKIP_WARNED_STOCKS).
# false 이면 아래 TRADE_SYMBOLS 고정 목록만 봅니다.
DYNAMIC_UNIVERSE=false
MAX_UNIVERSE=8
SKIP_WARNED_STOCKS=true

# 고정 대상 종목 (DYNAMIC_UNIVERSE=false 일 때만 사용. 쉼표 구분, KRX 6자리). 예: 005930,000660
TRADE_SYMBOLS=069500

# 봉(캔들) — AI 판단에 종목별 OHLCV 봉을 함께 제공해 추세/패턴을 읽게 함.
# CANDLE_INTERVAL: 1d(일봉) | 1m(분봉).  CANDLE_COUNT: 봉 개수(많을수록 토큰비↑).
CANDLE_INTERVAL=1d
CANDLE_COUNT=15

# 1회 주문 최대 금액(원) 상한 — 이 금액을 넘는 주문은 거부됩니다.
MAX_ORDER_KRW=100000

# 하루 최대 주문 횟수.
MAX_TRADES_PER_DAY=5

# 하루 최대 손실(원). 당일 실현/평가 손실이 이 값을 넘으면 그날 매매 중단(킬스위치).
MAX_DAILY_LOSS_KRW=50000

# 폭락 시 미체결 '매수 지정가' 주문 강제 취소 임계치(%). 0이면 비활성.
#  - A) 현재가가 최근 N분 고점 대비 이 % 이상 하락(연속 하락, 체결 전 차단)
#  - B) 현재가가 매수 지정가 대비 이 % 이상 낮음(갭다운/VI 안전망)
# 킬스위치/주문횟수와 무관하게 동작하며 DRY_RUN이면 실제 취소 대신 로깅만 합니다.
CANCEL_BUY_DROP_PCT=3.0
# 위 A) 최근 고점을 계산할 1분봉 개수(분).
CANCEL_LOOKBACK_MIN=10

# 마케터블 리밋(%). 주문 직전 최신 호가로 약간 공격적인 지정가를 걸어 체결률을 높입니다 (α=이 값/100).
#  매수=현재가×(1+α) 이하 중 최고 매도호가. 갭업으로 밴드 밖이면 보류(추격 매수 방지, α=상한).
#  매도=현재가×(1−α) 이상 중 최저 매수호가. 폭락으로 밴드 밖이면 손절 위해 최우선 매수호가로 크로스.
#  호가 사다리에서 스냅하므로 항상 유효 틱. 0이면 비활성(최신 현재가로 그대로 지정가).
MARKETABLE_LIMIT_PCT=0.3

# ── 대시보드 (선택) ─────────────────────────────────────────
# 외부 공개 배포 시 토큰 인증. 설정하면 https://.../?token=값 으로 최초 접속(이후 쿠키).
# 비워두면 인증 없음(로컬 전용일 때만 권장). 길고 무작위한 값을 쓰세요.
DASHBOARD_TOKEN=
# 대시보드 포트(Cloudtype 는 PORT 를 따로 주입하면 그쪽이 우선).
DASHBOARD_PORT=8787

# ── DB (선택) ───────────────────────────────────────────────
# 설정하면 주문 감사 로그를 PostgreSQL 에 적재(영속). 없으면 state/orders.csv 폴백.
# Cloudtype 에 PostgreSQL 서비스를 띄우고 그 접속정보로 채우세요.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── 페이퍼(모의) 포트폴리오 ─────────────────────────────────
# DRY_RUN 에서 주문이 지정가에 체결됐다 가정하고 가상계좌 손익을 추적(DB 필요).
PAPER_START_KRW=1000000   # 가상 시작 현금(원)
PAPER_FEE_PCT=0.015       # 편도 수수료율(%)
PAPER_TAX_PCT=0.18        # 매도 거래세율(%)

# 매매를 허용할 세션 (쉼표 구분). pre=프리마켓, regular=정규장, after=애프터마켓
# 통합(KRX+NXT) 운영시간을 토스 API에서 그날그날 읽어옵니다.
# 정규장만 원하면 regular 만 남기세요.
TRADE_SESSIONS=pre,regular,after

# 루프 주기(초). 매매시간에 이 간격마다 판단/실행합니다.
LOOP_INTERVAL_SEC=300

# ── 모델 (2단 구조) ────────────────────────────────────────
# 1차 판단(매 루프, 저가 모델)이 BUY/SELL/HOLD 를 정하고,
# 매수/매도(BUY/SELL)인 건만 2차 상위 모델이 검증 → 반려되면 HOLD 강등.
# 대부분 HOLD라 상위 모델은 거의 안 불려 비용은 1차 모델 수준에 가깝다.
DECISION_MODEL=claude-haiku-4-5
REVIEW_MODEL=claude-opus-4-8
REVIEW_TRADES=true
# 종목 선정(스크리너)은 판단력이 필요해 상위 모델 권장
SCREENER_MODEL=claude-opus-4-8
